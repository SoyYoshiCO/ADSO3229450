<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ta Te Ti</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            background: #f4f4f4;

            font-family: Arial, sans-serif;
        }


        /* =========================
           TABLERO EXTERIOR
        ========================= */

        .tablero {
            width: 700px;
            height: 360px;

            padding: 28px;

            background: #d8d5c8;

            border-radius: 30px;

            border: 12px solid #bdb9aa;

            box-shadow:
                inset 5px 5px 12px #aaa79b,
                inset -5px -5px 12px #f4f2e8,
                8px 10px 20px rgba(0, 0, 0, 0.35);

            display: flex;
            justify-content: center;
            align-items: center;
        }


        /* =========================
           CUADRÍCULA
        ========================= */

        .juego {
            width: 100%;
            height: 100%;

            display: grid;

            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);

            gap: 7px;

            background: #292923;

            padding: 4px;

            box-shadow:
                inset 3px 3px 7px #171714,
                inset -3px -3px 7px #55554c;
        }


        /* =========================
           CASILLAS
        ========================= */

        .casilla {
            background: #d8d0bb;

            border: 2px solid #33332e;

            display: flex;
            justify-content: center;
            align-items: center;

            box-shadow:
                inset 3px 3px 5px rgba(0, 0, 0, 0.25),
                inset -3px -3px 5px rgba(255, 255, 255, 0.3);

            overflow: hidden;
        }


        /* =========================
           CÍRCULO
        ========================= */

        .circulo {
            width: 80px;
            height: 80px;

            border-radius: 50%;

            background: #f5f5f5;

            box-shadow:
                5px 6px 8px rgba(0, 0, 0, 0.3),
                inset 4px 4px 7px #d2d2d2,
                inset -4px -4px 7px #ffffff;

            position: relative;
        }

        .circulo::after {
            content: "";

            position: absolute;

            width: 42px;
            height: 42px;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border-radius: 50%;

            background: #d8d0bb;

            box-shadow:
                inset 2px 2px 5px rgba(0, 0, 0, 0.2);
        }


        /* =========================
           X AZUL
        ========================= */

        .equis {
            width: 90px;
            height: 90px;

            position: relative;

            filter:
                drop-shadow(4px 5px 3px rgba(0, 0, 0, 0.3));
        }

        .equis::before,
        .equis::after {
            content: "";

            position: absolute;

            width: 88px;
            height: 22px;

            background: #168df0;

            border-radius: 12px;

            left: 1px;
            top: 34px;

            box-shadow:
                inset 0 2px 2px rgba(255, 255, 255, 0.25),
                inset 0 -3px 3px rgba(0, 0, 0, 0.12);
        }

        .equis::before {
            transform: rotate(45deg);
        }

        .equis::after {
            transform: rotate(-45deg);
        }


        /* =========================
           ANIMACIÓN HOVER
        ========================= */

        .casilla:hover {
            background: #e1dac7;

            transform: scale(1.02);

            transition: 0.2s ease;
        }

        .casilla {
            transition: 0.2s ease;
        }

        .casilla:hover .circulo {
            transform: scale(1.05);

            box-shadow:
                5px 6px 10px rgba(0, 0, 0, 0.35),
                inset 5px 5px 8px #c8c8c8,
                inset -5px -5px 8px #ffffff;

            transition: 0.2s ease;
        }

        .casilla:hover .equis {
            transform: scale(1.05);

            transition: 0.2s ease;
        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 750px) {

            .tablero {
                width: 90vw;
                height: 46vw;

                padding: 20px;

                border-width: 8px;
            }

            .circulo {
                width: 11vw;
                height: 11vw;
            }

            .circulo::after {
                width: 6vw;
                height: 6vw;
            }

            .equis {
                width: 12vw;
                height: 12vw;
            }

            .equis::before,
            .equis::after {
                width: 12vw;
                height: 3vw;

                top: 4.5vw;
            }
        }

    </style>
</head>

<body>

    <div class="tablero">

        <div class="juego">

            <!-- FILA 1 -->

            <div class="casilla">
                <div class="circulo"></div>
            </div>

            <div class="casilla">
                <div class="equis"></div>
            </div>

            <div class="casilla">
                <div class="circulo"></div>
            </div>


            <!-- FILA 2 -->

            <div class="casilla">
                <div class="circulo"></div>
            </div>

            <div class="casilla">
                <div class="equis"></div>
            </div>

            <div class="casilla">
                <div class="equis"></div>
            </div>


            <!-- FILA 3 -->

            <div class="casilla">
                <div class="circulo"></div>
            </div>

            <div class="casilla">
                <div class="equis"></div>
            </div>

            <div class="casilla">
                <div class="equis"></div>
            </div>

        </div>

    </div>

</body>
</html>